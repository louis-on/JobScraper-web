# JobScraper — exemple de configuration
# Copiez ce fichier en .env et renseignez vos valeurs :  cp .env.example .env

# --- Configuration globale ---
JOBSCRAPER_DATA_DIR=./data
JOBSCRAPER_LOG_LEVEL=INFO
JOBSCRAPER_OUTPUT_FORMAT=json
# JOBSCRAPER_PROXY_URL=http://user:pass@proxy:port

# --- Adzuna (Indeed, Monster...) ---
# Clés gratuites sur https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- LinkedIn ---
LINKEDIN_ENABLED=true
LINKEDIN_DELAY=2.0
LINKEDIN_USE_SELENIUM=false
LINKEDIN_HEADLESS=true

# --- HelloWork ---
HELLOWORK_ENABLED=true
HELLOWORK_DELAY=2.0

# --- France Travail ---
FRANCE_TRAVAIL_ENABLED=true
FRANCE_TRAVAIL_DELAY=2.0

# --- Welcome to the Jungle ---
WTTJ_ENABLED=true
WTTJ_DELAY=1.0
